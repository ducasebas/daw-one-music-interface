[Unit]
Description=DAW ONE Wayland kiosk (simulation)
After=systemd-user-sessions.service daw-one.service
Requires=daw-one.service
Conflicts=getty@tty1.service
[Service]
User=dawone
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
TTYReset=yes
TTYVHangup=yes
UtmpIdentifier=tty1
Environment=XDG_RUNTIME_DIR=/run/daw-one-kiosk
RuntimeDirectory=daw-one-kiosk
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/cage -- /usr/bin/chromium --kiosk --no-first-run --disable-session-crashed-bubble --user-data-dir=/var/lib/dawone/chromium http://127.0.0.1:3001
Restart=on-failure
RestartSec=5
[Install]
WantedBy=multi-user.target
