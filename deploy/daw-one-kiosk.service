[Unit]
Description=DAW ONE Wayland kiosk (simulation)
After=systemd-user-sessions.service daw-one.service
Requires=daw-one.service
Conflicts=getty@tty1.service
[Service]
User=dawone
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
TTYReset=yes
TTYVHangup=yes
UtmpIdentifier=tty1
Environment=DAW_DISPLAY_MODE=hdmi-development
EnvironmentFile=-/etc/daw-one-display.env
Environment=XDG_RUNTIME_DIR=/run/daw-one-kiosk
RuntimeDirectory=daw-one-kiosk
RuntimeDirectoryMode=0700
ExecStart=/opt/daw-one/kiosk.sh
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=5
[Install]
WantedBy=multi-user.target
