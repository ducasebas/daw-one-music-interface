[Unit]
Description=TuneBox music interface and device state
After=network.target
[Service]
Type=simple
User=dawone
Group=dawone
WorkingDirectory=/opt/daw-one
ExecStart=/usr/bin/env node server/index.js
EnvironmentFile=-/etc/daw-one.env
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3001
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
MemoryMax=256M
StateDirectory=daw-one-state
StateDirectoryMode=0700
Environment=DAW_STATE_DIR=/var/lib/daw-one-state
StandardOutput=journal
StandardError=journal
[Install]
WantedBy=multi-user.target
