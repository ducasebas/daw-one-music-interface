{
  "name": "daw-one",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --env-file-if-exists=.env server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "test:ui": "playwright test",
    "check": "npm test && npm run build",
    "test:offline": "playwright test -c playwright.production.config.js",
    "test:webkit": "playwright test -c playwright.webkit.config.js",
    "doctor": "node server/doctor.js",
    "package:pi": "npm run check && node deploy/release-bundle.js pack"
  },
  "dependencies": {
    "express": "^5.1.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "concurrently": "^9.2.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "license": "MIT"
}
