# Copy to .env (ignored by Git). Never paste a token into chat or commit it.
DAW_PLAYBACK_MODE=simulation
# For a real MA connection change mode to music-assistant and configure:
# MA_URL=http://your-music-assistant-host:8095
# MA_TOKEN_FILE=/absolute/path/to/music-assistant-token
# Or use a Codespaces secret named MA_TOKEN (not browser local storage).
# MA_PLAYER_ID=exact-player-id
# Start read-only. Enable controls explicitly after selecting the correct player.
MA_ALLOW_CONTROL=false
MA_VOLUME_LIMIT=40
